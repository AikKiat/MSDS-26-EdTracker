{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UseSamTransform",
      "Effect": "Allow",
      "Action": "cloudformation:CreateChangeSet",
      "Resource": "arn:aws:cloudformation:ap-southeast-1:aws:transform/Serverless-2016-10-31"
    },
    {
      "Sid": "PassEdTrackerLambdaRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::857196482054:role/edtracker-lambda-execution",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageEdTrackerLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:AddPermission",
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:ListTags",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": "arn:aws:lambda:ap-southeast-1:857196482054:function:edtracker-dev-api"
    },
    {
      "Sid": "ReadLambdaLayersForCreate",
      "Effect": "Allow",
      "Action": "lambda:GetLayerVersion",
      "Resource": "*"
    },
    {
      "Sid": "ValidateExistingLambdaVpcConfiguration",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UseExactS3GatewayEndpointNetworkResources",
      "Effect": "Allow",
      "Action": "ec2:CreateVpcEndpoint",
      "Resource": [
        "arn:aws:ec2:ap-southeast-1:857196482054:vpc/vpc-0ae5071e51958a0cd",
        "arn:aws:ec2:ap-southeast-1:857196482054:route-table/rtb-041a655344cf2b5de"
      ]
    },
    {
      "Sid": "CreateExactS3GatewayEndpoint",
      "Effect": "Allow",
      "Action": "ec2:CreateVpcEndpoint",
      "Resource": "arn:aws:ec2:ap-southeast-1:857196482054:vpc-endpoint/*",
      "Condition": {
        "StringEquals": {
          "ec2:VpceServiceName": "com.amazonaws.ap-southeast-1.s3"
        }
      }
    },
    {
      "Sid": "ManageEdTrackerS3GatewayEndpoint",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVpcEndpoints",
        "ec2:ModifyVpcEndpoint"
      ],
      "Resource": "arn:aws:ec2:ap-southeast-1:857196482054:vpc-endpoint/*",
      "Condition": {
        "StringEquals": {
          "ec2:VpceServiceName": "com.amazonaws.ap-southeast-1.s3"
        }
      }
    },
    {
      "Sid": "DescribeEdTrackerVpcEndpoint",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeRouteTables",
        "ec2:DescribeVpcEndpointServices",
        "ec2:DescribeVpcEndpoints"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageEdTrackerLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:DeleteRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:PutRetentionPolicy",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": [
        "arn:aws:logs:ap-southeast-1:857196482054:log-group:/aws/http-api/edtracker-dev:*",
        "arn:aws:logs:ap-southeast-1:857196482054:log-group:/aws/lambda/edtracker-dev-api:*"
      ]
    },
    {
      "Sid": "DescribeLogGroupsForAttributes",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "ManageApiAccessLogDelivery",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogDelivery",
        "logs:DeleteLogDelivery",
        "logs:DescribeResourcePolicies",
        "logs:GetLogDelivery",
        "logs:ListLogDeliveries",
        "logs:PutResourcePolicy",
        "logs:UpdateLogDelivery"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageEdTrackerHttpApi",
      "Effect": "Allow",
      "Action": [
        "apigateway:DELETE",
        "apigateway:GET",
        "apigateway:PATCH",
        "apigateway:POST",
        "apigateway:PUT"
      ],
      "Resource": [
        "arn:aws:apigateway:ap-southeast-1::/apis",
        "arn:aws:apigateway:ap-southeast-1::/apis/*",
        "arn:aws:apigateway:ap-southeast-1::/tags/*"
      ]
    },
    {
      "Sid": "ManageExactEdTrackerHttpApiStage",
      "Effect": "Allow",
      "Action": "apigateway:*",
      "Resource": [
        "arn:aws:apigateway:ap-southeast-1::/apis/0cu1jmf5r7/stages",
        "arn:aws:apigateway:ap-southeast-1::/apis/0cu1jmf5r7/stages/*"
      ]
    },
    {
      "Sid": "ReadSamArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::msds-857196482054-ap-southeast-1-an/sam-artifacts/edtracker-dev/*"
    }
  ]
}
