{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UseAssetsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::msds-857196482054-ap-southeast-1-an/*"
    },
    {
      "Sid": "ListAssetsBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::msds-857196482054-ap-southeast-1-an"
    },
    {
      "Sid": "WriteXRayTelemetry",
      "Effect": "Allow",
      "Action": [
        "xray:PutTelemetryRecords",
        "xray:PutTraceSegments"
      ],
      "Resource": "*"
    }
  ]
}
