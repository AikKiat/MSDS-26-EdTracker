{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployEdTrackerStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DeleteStack",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStacks",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": [
        "arn:aws:cloudformation:ap-southeast-1:857196482054:stack/edtracker-dev/*",
        "arn:aws:cloudformation:ap-southeast-1:aws:transform/Serverless-2016-10-31"
      ]
    },
    {
      "Sid": "UploadSamArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::msds-857196482054-ap-southeast-1-an/sam-artifacts/edtracker-dev/*"
    },
    {
      "Sid": "ReadSamArtifactBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::msds-857196482054-ap-southeast-1-an"
    },
    {
      "Sid": "PassEdTrackerCloudFormationRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::857196482054:role/edtracker-cloudformation-execution",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    }
  ]
}
