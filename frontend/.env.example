# Set this to the ApiUrl output from the AWS SAM stack.
# Vite exposes only VITE_-prefixed variables to browser code.
VITE_API_BASE_URL=https://example.execute-api.ap-southeast-1.amazonaws.com

# The backend does not serve course/item endpoints yet, so the app talks to the
# in-memory mock backend in src/mocks. Set to "false" to call VITE_API_BASE_URL.
VITE_USE_MOCKS=true
